    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [888, 264.0]
    rotation: 0
    state: true
- name: n_keep
  id: variable
  parameters:
    comment: ''
    value: int(bit_samples * 0.3)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [592, 264.0]
    rotation: 0
    state: enabled
- name: n_skip
  id: variable
  parameters:
    comment: ''
    value: int((bit_samples - n_keep) / 2)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [592, 336.0]
    rotation: 0
    state: enabled
- name: samp_rate

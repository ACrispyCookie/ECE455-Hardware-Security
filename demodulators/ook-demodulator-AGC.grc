    rotation: 0
    state: enabled
- name: samp_rate_new
  id: variable
  parameters:
    comment: ''
    value: samp_rate / decim
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [592, 176.0]
    rotation: 0
    state: enabled
